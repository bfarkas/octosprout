{
  "name": "@octosprout/server",
  "version": "0.0.0",
  "private": true,
  "description": "octosprout-server: inbox API, web UI and JSON API, auth, approvals and the Git write service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octosprout/core": "workspace:*",
    "fastify": "^5.12.7"
  },
  "bin": {
    "octosprout-server": "./dist/main.js"
  }
}
