{
  "name": "@octosprout/cli",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "octosprout CLI and local stdio MCP server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bin": {
    "octosprout": "./dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@octosprout/core": "workspace:*",
    "zod": "^4.6.7"
  }
}
