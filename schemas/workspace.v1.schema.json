{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octosprout.de/schemas/workspace.v1.schema.json",
  "title": "OctoSprout workspace configuration (octosprout.yaml), version 1",
  "description": "Spec §5.3. Changes to this file are consequential (§9.2).",
  "type": "object",
  "required": ["workspace_schema_version", "id_prefix"],
  "properties": {
    "workspace_schema_version": {
      "const": 1
    },
    "id_prefix": {
      "const": "OS"
    },
    "approval_public_keys": {
      "description": "Ed25519 public keys trusted for approval signatures. Retired keys stay listed so old approvals remain valid (§18.5).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "key"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "key": {
            "description": "ed25519:<base64 of the raw 32-byte public key>",
            "type": "string",
            "pattern": "^ed25519:[A-Za-z0-9+/]{43}=$"
          },
          "status": {
            "enum": ["active", "retired"]
          }
        }
      }
    },
    "consequential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bulk_threshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false
}
