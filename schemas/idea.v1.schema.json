{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octosprout.de/schemas/idea.v1.schema.json",
  "title": "OctoSprout idea record frontmatter, version 1",
  "description": "Spec §6.5 (Idea) and §7.2. The body is free-form Markdown.",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "title",
    "status",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OS-I-[0-9A-HJKMNP-TV-Z]{5}$"
    },
    "type": {
      "const": "idea"
    },
    "schema_version": {
      "const": 1
    },
    "title": {
      "$ref": "common.v1.schema.json#/$defs/title"
    },
    "status": {
      "enum": [
        "seed",
        "sprouting",
        "ready",
        "dormant",
        "transplanted",
        "composted"
      ]
    },
    "created": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "updated": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "tags": {
      "$ref": "common.v1.schema.json#/$defs/tags"
    },
    "links": {
      "$ref": "common.v1.schema.json#/$defs/links"
    },
    "refs": {
      "$ref": "common.v1.schema.json#/$defs/refs"
    },
    "approval": {
      "$ref": "common.v1.schema.json#/$defs/proposalId"
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false
}
