{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octosprout.de/schemas/expert.v1.schema.json",
  "title": "OctoSprout expert profile frontmatter, version 1",
  "description": "Spec §6.5 (Expert), §7.7 and §14. Profiles are simulated; their advice is never human review.",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "title",
    "status",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OS-E-[0-9A-HJKMNP-TV-Z]{5}$"
    },
    "type": {
      "const": "expert"
    },
    "schema_version": {
      "const": 1
    },
    "title": {
      "$ref": "common.v1.schema.json#/$defs/title"
    },
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "created": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "updated": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "tags": {
      "$ref": "common.v1.schema.json#/$defs/tags"
    },
    "links": {
      "$ref": "common.v1.schema.json#/$defs/links"
    },
    "refs": {
      "$ref": "common.v1.schema.json#/$defs/refs"
    },
    "approval": {
      "$ref": "common.v1.schema.json#/$defs/proposalId"
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false
}
